      "style": {
        "navigationBarTitleText": "AI对话",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/robot/index",
      "style": {
        "navigationBarTitleText": "机器人管理",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "个人中心",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/demo/index",
      "style": {
        "navigationBarTitleText": "组件管理",
