# ===========================================
# .env.staging (测试环境)
# ===========================================

# 环境标识
NODE_ENV=production
VITE_ENV=staging

# API配置
VITE_API_BASE_URL=https://staging-api.example.com
VITE_API_TIMEOUT=20000

# WebSocket配置
VITE_WS_URL=wss://staging-ws.example.com

# 静态资源配置
VITE_CDN_URL=https://staging-cdn.example.com
VITE_STATIC_URL=https://staging-static.example.com

# 调试配置
VITE_DEBUG=false
VITE_LOG_LEVEL=info
VITE_ENABLE_VCONSOLE=false