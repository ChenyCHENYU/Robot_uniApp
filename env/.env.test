# ===========================================
# .env.test (测试环境)
# ===========================================

# 环境标识
NODE_ENV=test
VITE_ENV=test

# API配置
VITE_API_BASE_URL=https://test-api.example.com
VITE_API_TIMEOUT=25000

# WebSocket配置
VITE_WS_URL=wss://test-ws.example.com

# 静态资源配置
VITE_CDN_URL=https://test-cdn.example.com
VITE_STATIC_URL=https://test-static.example.com

# 调试配置
VITE_DEBUG=true
VITE_LOG_LEVEL=debug
VITE_ENABLE_VCONSOLE=true