# ===========================================
# .env (通用配置 - 所有环境共享)
# ===========================================

# 应用基础信息
VITE_APP_TITLE=企业应用框架
VITE_APP_VERSION=1.7.2

# API通用配置
VITE_API_VERSION=v1
VITE_API_TIMEOUT=15000

# App 热更新清单地址（App 端 wgt 升级，详见 services/app-update）
VITE_APP_UPDATE_MANIFEST=

# App 热更新清单地址（App 端 wgt 升级，详见 services/app-update）
# VITE_APP_UPDATE_MANIFEST=https://cdn.example.com/app/update-manifest.json

# 简繁转换（开启后懒加载约 1.1MB opencc 字典 chunk）
VITE_FEATURE_TW=false
