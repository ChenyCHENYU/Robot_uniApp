# ===========================================
# .env.development (开发环境)
# ===========================================

# 环境标识
VITE_ENV=development
VITE_MOCK_ENABLED=true

# API配置
# H5 端走 vite proxy（/api → VITE_API_PROXY_TARGET）
# 小程序/App 端无法使用代理，将自动回退到 VITE_API_PROXY_TARGET
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=https://dev-api.example.com
VITE_API_TIMEOUT=30000

# WebSocket配置
VITE_WS_URL=wss://dev-ws.example.com

# 静态资源配置
VITE_CDN_URL=https://dev-cdn.example.com
VITE_STATIC_URL=https://dev-static.example.com

# 调试配置
VITE_DEBUG=true
VITE_LOG_LEVEL=debug
VITE_ENABLE_VCONSOLE=true
