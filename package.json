{
  "name": "robot-uniapp",
  "version": "1.0.0",
  "description": "Robot_uniApp - 企业级跨平台应用开发框架",
  "scripts": {
    "// 开发环境": "",
    "dev": "uni --mode development -p h5",
    "dev:h5": "uni --mode development -p h5",
    "dev:wx": "uni --mode development -p mp-weixin",
    "dev:app": "uni --mode development -p app",
    "// 生产构建": "",
    "build": "uni build --mode production -p h5",
    "build:h5": "uni build --mode production -p h5",
    "build:wx": "uni build --mode production -p mp-weixin",
    "build:app": "uni build --mode production -p app",
    "build:app-android": "uni build --mode production -p app-android",
    "build:app-ios": "uni build --mode production -p app-ios",
    "// 测试环境": "",
    "test": "uni --mode test -p h5",
    "test:wx": "uni --mode test -p mp-weixin",
    "test:app": "uni --mode test -p app",
    "// 预发布环境": "",
    "staging": "uni --mode staging -p h5",
    "staging:wx": "uni --mode staging -p mp-weixin",
    "staging:app": "uni --mode staging -p app",
    "// 推送代码": "",
    "push": "git push origin main && git push gitee main && git push gitcode main",
    "prepare": "husky",
    "cz": "git-cz",
    "lint": "oxlint . --fix -D correctness --ignore-path .gitignore && eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4070620250821001",
    "@dcloudio/uni-app-plus": "3.0.0-4070620250821001",
    "@dcloudio/uni-components": "3.0.0-4070620250821001",
    "@dcloudio/uni-h5": "3.0.0-4070620250821001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4070620250821001",
    "@iconify-json/mdi": "^1.2.3",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^3.2.3",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
    "wot-design-uni": "^1.14.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-4070620250821001",
    "@dcloudio/uni-cli-shared": "3.0.0-4070620250821001",
    "@dcloudio/uni-stacktracey": "3.0.0-4070620250821001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4070620250821001",
    "@iconify-json/fluent": "^1.2.41",
    "@iconify-json/fluent-color": "^1.2.21",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/solar": "^1.2.5",
    "@robot-admin/git-standards": "^1.0.3",
    "@types/node": "^25.5.0",
    "@uni-helper/unocss-preset-uni": "^0.2.11",
    "@unocss/preset-attributify": "^66.5.1",
    "@unocss/preset-icons": "^66.5.1",
    "@unocss/preset-uno": "^66.5.1",
    "@unocss/preset-wind3": "^66.5.1",
    "@unocss/transformer-directives": "^66.5.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/runtime-core": "^3.5.30",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.5.1",
    "eslint": "^10.0.3",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-oxlint": "^1.56.0",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.56.0",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "typescript": "~5.7.3",
    "unocss": "^66.5.1",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^5"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,vue}": [
      "oxlint --max-warnings 0 --deny-warnings",
      "eslint --fix --no-cache",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
